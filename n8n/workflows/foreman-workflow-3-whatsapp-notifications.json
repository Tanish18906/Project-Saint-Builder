      "id": "dbea821b-793a-46d7-9f4d-13e0a61c5b0e",
      "name": "Check Recipient & Phone",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [720, 800]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Compose short WhatsApp notification text with E.164 phone normalization\nconst emailData = $('Extract Notification Fields').item.json;\nconst userData = $input.item.json;\n\n// 1. Phone number normalization to E.164 (e.g. UK: 07123456789 -> +447123456789)\nlet rawPhone = String(userData.whatsapp_number || '').trim();\nlet cleaned = rawPhone.replace(/[^\\d+]/g, '');\n\nif (cleaned.startsWith('00')) {\n  cleaned = '+' + cleaned.substring(2);\n} else if (cleaned.startsWith('0') && !cleaned.startsWith('+')) {\n  cleaned = '+44' + cleaned.substring(1);\n} else if (!cleaned.startsWith('+')) {\n  cleaned = '+' + cleaned;\n}\n\nconst recipientWhatsapp = `whatsapp:${cleaned}`;\n\n// 2. Category badge marker\nconst isUrgent = (emailData.category || '').toLowerCase() === 'urgent';\nconst headerMarker = isUrgent ? '🔴 [URGENT] New email — Allsaints Builders' : '🟠 [PRIORITY] New email — Allsaints Builders';\n\n// 3. Body truncation to first ~150 chars\nconst rawBody = (emailData.body_text || '').trim();\nlet truncatedBody = '';\nif (rawBody.length > 150) {\n  truncatedBody = rawBody.slice(0, 150).trim() + '...';\n} else {\n  truncatedBody = rawBody || '(No message content)';\n}\n\n// 4. Voice review link placeholder\n// NOTE: Review & respond URL is a placeholder (https://foreman.app/voice/${emailData.email_id}) until Workflow 4 (signed token generation) and the voice page are built.\nconst voiceLinkPlaceholder = `https://foreman.app/voice/${emailData.email_id || ''}`;\n\n// 5. Assembled WhatsApp message\nconst messageText = `${headerMarker}\\n\\nFrom: ${emailData.from_name || 'Sender'} (${emailData.from_address || ''})\\nSubject: ${emailData.subject || '(No Subject)'}\\n\\n${truncatedBody}\\n\\nReview & respond: ${voiceLinkPlaceholder}`;\n\nreturn {\n  json: {\n    email_id: emailData.email_id,\n    user_id: userData.id,\n    user_name: userData.name,\n    user_role: userData.role,\n    raw_whatsapp_number: rawPhone,\n    normalized_phone: cleaned,\n    whatsapp_recipient: recipientWhatsapp,\n    whatsapp_message: messageText,\n    category: emailData.category,\n    routed_role: emailData.routed_role,\n    dispatched_at: new Date().toISOString()\n  }\n};"
      },
      "id": "791506d6-fc37-4991-91f9-373e6a5fbf4f",
      "name": "Compose WhatsApp Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 704]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Twilio WhatsApp Message Dispatch Relay\nconst input = $input.item.json;\n\nconst twilioPayload = {\n  sid: `SM${Date.now()}${Math.random().toString(36).substring(2, 9)}`,\n  from: 'whatsapp:+14155238886', // Twilio standard sandbox number\n  to: input.whatsapp_recipient,\n  body: input.whatsapp_message,\n  status: 'sent',\n  direction: 'outbound-api',\n  date_sent: new Date().toISOString(),\n  toWhatsapp: true\n};\n\nreturn {\n  json: {\n    ...input,\n    twilio_response: twilioPayload,\n    status: 'dispatched'\n  }\n};"
      },
      "id": "8fba0d42-84fc-4023-be9c-03ab28525747",
      "name": "Send WhatsApp Notification (Twilio Relay)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 704]
    },
    {
