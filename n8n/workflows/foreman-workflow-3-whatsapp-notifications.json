              "fieldValue": "whatsapp_notified"
            },
            {
              "fieldId": "details",
              "fieldValue": "={{ JSON.stringify({ category: $('Compose WhatsApp Message').item.json.category, routed_role: $('Compose WhatsApp Message').item.json.routed_role, whatsapp_number: $('Compose WhatsApp Message').item.json.raw_whatsapp_number ? $('Compose WhatsApp Message').item.json.raw_whatsapp_number.replace(/\\d(?=\\d{4})/g, '*') : null, recipient: $('Compose WhatsApp Message').item.json.whatsapp_recipient, status: 'dispatched' }) }}"
            }
          ]
        }
      },
