    {
      "parameters": {
        "jsCode": "// Explicit set-based matching — avoids relying on n8n's alwaysOutputData\n// per-item placeholder semantics (which only synthesize ONE empty item for\n// a whole zero-result node run, not one per input item).\nconst emailData = $('Extract Notification Fields').first().json;\nconst rolesNeeded = Array.isArray(emailData.routed_roles) ? emailData.routed_roles : [];\nconst candidates = $input.all().map((item) => item.json);\n\nconst seenUserIds = new Set();\nconst output = [];\n\nfor (const role of rolesNeeded) {\n  const match = candidates.find((u) => u.role === role && u.whatsapp_number && !seenUserIds.has(u.id));\n  if (match) {\n    seenUserIds.add(match.id);\n    output.push({\n      json: { _kind: 'matched', id: match.id, name: match.name, role: match.role, whatsapp_number: match.whatsapp_number },\n      pairedItem: { item: 0 }\n    });\n  } else {\n    output.push({\n      json: { _kind: 'skipped', role: role },\n      pairedItem: { item: 0 }\n    });\n  }\n}\n\nreturn output;"
      },
