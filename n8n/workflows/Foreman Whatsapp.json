    {
      "parameters": {
        "content": "# 📱 WORKFLOW 3: WhatsApp Notifications\n---\n**Trigger:** Supabase Database Webhook fired when a new row is inserted into `emails`.\n**Filter:** Only fires for `urgent` or `priority` emails.\n**Action:** Looks up recipient user by `routed_role`, formats WhatsApp message with E.164 normalization, dispatches via Twilio WhatsApp, and logs event in `audit_log` (`whatsapp_notified` or `whatsapp_skipped_no_recipient`).",
        "height": 180,
        "width": 640,
        "color": "#000000"
      },
      "id": "0c1e8551-2c43-4425-bae9-639c7d312099",
      "name": "Title — Workflow 3: WhatsApp Notifications",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -1968,
        64
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Generate signed HMAC-SHA256 token for voice review link\nconst crypto = require('crypto');\n\n// Secret matches VOICE_TOKEN_SECRET in dashboard / Next.js voice-token.ts\nconst secret = 'foreman-voice-secret-key-3b7c89f2a4e10d';\nconst emailData = $('Extract Notification Fields').item.json;\nconst emailId = emailData.email_id || $input.item.json.email_id || '';\n\n// 24-hour expiration\nconst now = Math.floor(Date.now() / 1000);\nconst exp = now + 24 * 3600;\n\nconst header = { alg: 'HS256', typ: 'JWT' };\nconst payload = {\n  email_id: emailId,\n  exp: exp,\n  iat: now,\n};\n\nconst encodedHeader = Buffer.from(JSON.stringify(header), 'utf8').toString('base64url');\nconst encodedPayload = Buffer.from(JSON.stringify(payload), 'utf8').toString('base64url');\nconst dataToSign = `${encodedHeader}.${encodedPayload}`;\n\nconst signature = crypto\n  .createHmac('sha256', secret)\n  .update(dataToSign)\n  .digest('base64url');\n\nconst voiceToken = `${dataToSign}.${signature}`;\n\nreturn {\n  json: {\n    ...$input.item.json,\n    voice_token: voiceToken,\n    voice_token_exp: exp,\n    voice_token_iat: now,\n  }\n};"
      },
      "id": "0c416ddd-5df2-4e45-b8c8-4af703ed22c8",
      "name": "Generate Signed Voice Token",
