    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Compose clean, structured WhatsApp notification text for foreman_email_alert_v2\nconst emailData = $('Extract Notification Fields').item.json;\nconst userData = $input.item.json;\nconst voiceToken = $input.item.json.voice_token || '';\n\n// 1. Phone number normalization to E.164\nlet rawPhone = String(userData.whatsapp_number || '').trim();\nlet cleaned = rawPhone.replace(/[^\\d+]/g, '');\n\nif (cleaned.startsWith('00')) {\n  cleaned = '+' + cleaned.substring(2);\n} else if (cleaned.startsWith('0') && !cleaned.startsWith('+')) {\n  cleaned = '+44' + cleaned.substring(1);\n} else if (!cleaned.startsWith('+')) {\n  cleaned = '+' + cleaned;\n}\n\nconst recipientWhatsapp = `whatsapp:${cleaned}`;\n\n// 2. Clean subject and urgency tag (strip redundant \"URGENT:\" or \"PRIORITY:\" from subject)\nlet cleanSubject = (emailData.subject || '(No Subject)').trim();\ncleanSubject = cleanSubject.replace(/^(urgent|priority)[\\s:_\\-–—]+|^\\[(urgent|priority)\\][\\s:_\\-–—]+/i, '').trim();\nconst isUrgent = (emailData.urgency || '').toLowerCase() === 'urgent';\nconst urgencyTag = isUrgent ? '🔴 URGENT' : '🟠 PRIORITY';\nconst templateVar1 = `*${cleanSubject}* (${urgencyTag})`;\n\n// 3. Clean sender and body snippet (avoid repeating subject or urgent tag)\nconst senderName = (emailData.from_name || 'Sender').trim();\nconst senderOrg = emailData.from_address ? ` (${emailData.from_address})` : '';\n\nlet cleanBody = (emailData.body_text || '').trim();\ncleanBody = cleanBody.replace(/^(urgent|priority)[\\s:_\\-–—]+|^\\[(urgent|priority)\\][\\s:_\\-–—]+/i, '').trim();\nif (cleanSubject && cleanBody.toLowerCase().startsWith(cleanSubject.toLowerCase())) {\n  cleanBody = cleanBody.slice(cleanSubject.length).replace(/^[\\s:_\\-–—.,]+/, '').trim();\n}\n// Strip newlines inside the variable so Meta API accepts it\ncleanBody = cleanBody.replace(/[\\r\\n\\t]+/g, ' ').replace(/\\s{2,}/g, ' ').trim();\nif (cleanBody.length > 120) {\n  cleanBody = cleanBody.slice(0, 120).trim() + '...';\n}\n\nconst templateVar2 = `👤 *${senderName}*${senderOrg}: \"${cleanBody || 'Please review the email thread for details.'}\"`;\n\n// 4. Voice link\nconst dashboardBaseUrl = 'http://localhost:3000';\nconst voiceLink = `${dashboardBaseUrl}/voice/${emailData.email_id || ''}?token=${voiceToken}`;\n\nconst contentVars = JSON.stringify({\n  '1': templateVar1,\n  '2': templateVar2,\n  '3': voiceLink\n});\n\nreturn {\n  json: {\n    email_id: emailData.email_id,\n    user_id: userData.id,\n    user_name: userData.name,\n    user_role: userData.role,\n    raw_whatsapp_number: rawPhone,\n    normalized_phone: cleaned,\n    whatsapp_recipient: recipientWhatsapp,\n    template_sid: 'HX194c1a768e080836d54f52d3abd34aed',\n    template_var_1: templateVar1,\n    template_var_2: templateVar2,\n    template_var_3: voiceLink,\n    content_variables: contentVars,\n    voice_token: voiceToken,\n    voice_url: voiceLink,\n    urgency: emailData.urgency,\n    dispatched_at: new Date().toISOString()\n  }\n};"
      },
