    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Compose short WhatsApp notification text with E.164 phone normalization\nconst emailData = $('Extract Notification Fields').item.json;\nconst userData = $input.item.json;\nconst voiceToken = $input.item.json.voice_token || '';\n\n// 1. Phone number normalization to E.164 (e.g. UK: 07123456789 -> +447123456789)\nlet rawPhone = String(userData.whatsapp_number || '').trim();\nlet cleaned = rawPhone.replace(/[^\\d+]/g, '');\n\nif (cleaned.startsWith('00')) {\n  cleaned = '+' + cleaned.substring(2);\n} else if (cleaned.startsWith('0') && !cleaned.startsWith('+')) {\n  cleaned = '+44' + cleaned.substring(1);\n} else if (!cleaned.startsWith('+')) {\n  cleaned = '+' + cleaned;\n}\n\nconst recipientWhatsapp = `whatsapp:${cleaned}`;\n\n// 2. Category badge marker\nconst isUrgent = (emailData.category || '').toLowerCase() === 'urgent';\nconst headerMarker = isUrgent ? '🔴 [URGENT] New email — Allsaints Builders' : '🟠 [PRIORITY] New email — Allsaints Builders';\n\n// 3. Body truncation to first ~150 chars\nconst rawBody = (emailData.body_text || '').trim();\nlet truncatedBody = '';\nif (rawBody.length > 150) {\n  truncatedBody = rawBody.slice(0, 150).trim() + '...';\n} else {\n  truncatedBody = rawBody || '(No message content)';\n}\n\n// 4. Real signed voice review link (24-hour validity)\n// TEMPORARY — hardcoded to localhost for local dev testing. Replace with the real\n// production domain once the dashboard is deployed, or once environment variables\n// become available (e.g. after a plan upgrade).\nconst dashboardBaseUrl = 'http://localhost:3000';\nconst voiceLink = `${dashboardBaseUrl}/voice/${emailData.email_id || ''}?token=${voiceToken}`;\n\n// 5. Assembled WhatsApp message\nconst messageText = `${headerMarker}\\n\\nFrom: ${emailData.from_name || 'Sender'} (${emailData.from_address || ''})\\nSubject: ${emailData.subject || '(No Subject)'}\\n\\n${truncatedBody}\\n\\nReview & respond: ${voiceLink}`;\n\nreturn {\n  json: {\n    email_id: emailData.email_id,\n    user_id: userData.id,\n    user_name: userData.name,\n    user_role: userData.role,\n    raw_whatsapp_number: rawPhone,\n    normalized_phone: cleaned,\n    whatsapp_recipient: recipientWhatsapp,\n    whatsapp_message: messageText,\n    voice_token: voiceToken,\n    voice_url: voiceLink,\n    category: emailData.category,\n    routed_role: emailData.routed_role,\n    dispatched_at: new Date().toISOString()\n  }\n};"
      },
