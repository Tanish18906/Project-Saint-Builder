# Supabase Configuration for Foreman Dashboard
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key-here

# Supabase Server/Backend Configuration
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key-here

# OpenAI (voice STT / TTS / agent / rewrite)
OPENAI_API_KEY=sk-your-openai-key-here

# Voice portal HMAC token secret (must match n8n Workflow 3). Generate: openssl rand -base64 32
VOICE_TOKEN_SECRET=your-long-random-secret-here

# Public base URL of the deployed app (used in voice links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
